library(dplyr)
# Assuming gym_members_data is already loaded
library(ggplot2)
library(dplyr)
library(viridis)  # For a color-blind friendly palette
library(ggplot2)
library(dplyr)
library(scales)  # For custom color scales
# Create custom color scales for men and women
blue_scale <- scale_color_gradient(low = "lightblue", high = "darkblue")
pink_scale <- scale_color_gradient(low = "pink", high = "deeppink")
# Calculate the range of CaloriesBurned for proper scaling
cal_range <- range(gym_members_data$CaloriesBurned)
ggplot(gym_members_data, aes(x = BMI, y = FatPercentage, color = CaloriesBurned)) +
geom_point(data = subset(gym_members_data, Gender == "Male"), alpha = 0.8, size = 3) +
geom_point(data = subset(gym_members_data, Gender == "Female"), alpha = 0.8, size = 3) +
facet_wrap(~ExperienceLevel, labeller = labeller(ExperienceLevel = c("1" = "Beginner", "2" = "Intermediate", "3" = "Advanced"))) +
scale_color_gradientn(colours = c("lightblue", "darkblue", "pink", "deeppink"),
values = rescale(c(cal_range[1], mean(cal_range), mean(cal_range), cal_range[2])),
guide = "colorbar",
name = "Calories\nBurned") +
labs(title = "Relationship between BMI, Fat Percentage, and Calories Burned",
subtitle = "Grouped by Experience Level and Gender",
x = "Body Mass Index (BMI)",
y = "Fat Percentage") +
theme_minimal(base_size = 14) +
theme(legend.position = "right",
plot.title = element_text(hjust = 0.5, face = "bold"),
plot.subtitle = element_text(hjust = 0.5)) +
geom_smooth(aes(group = Gender), method = "lm", se = FALSE, linetype = "dashed", alpha = 0.5, color = "black") +
annotate("rect", xmin = 18.5, xmax = 24.9, ymin = -Inf, ymax = Inf,
fill = "green", alpha = 0.1) +
annotate("text", x = 21.7, y = min(gym_members_data$FatPercentage) + 1,
label = "Healthy BMI Range", fontface = "bold", vjust = 0) +
coord_cartesian(clip = "off") +
# Add a custom legend for gender
annotate("point", x = max(gym_members_data$BMI), y = max(gym_members_data$FatPercentage),
color = "blue", size = 3) +
annotate("text", x = max(gym_members_data$BMI), y = max(gym_members_data$FatPercentage),
label = " Male", hjust = 0, vjust = 0.5) +
annotate("point", x = max(gym_members_data$BMI), y = max(gym_members_data$FatPercentage) - 2,
color = "pink", size = 3) +
annotate("text", x = max(gym_members_data$BMI), y = max(gym_members_data$FatPercentage) - 2,
label = " Female", hjust = 0, vjust = 0.5)
ggsave("gym_fitness_analysis_blue_pink.png", width = 12, height = 8, dpi = 300)
install.packages("patchwork")
library(ggplot2)
library(dplyr)
# Assuming gym_members_data is already loaded
library(ggplot2)
library(dplyr)
library(viridis)  # For a color-blind friendly palette
library(ggplot2)
library(dplyr)
library(scales)  # For custom color scales
library(ggplot2)
library(dplyr)
library(patchwork)  # For combining plots
# Function to create plot for a single gender
create_gender_plot <- function(data, gender, color_low, color_high) {
ggplot(data, aes(x = BMI, y = FatPercentage, color = CaloriesBurned)) +
geom_point(alpha = 0.8, size = 3) +
facet_wrap(~ExperienceLevel, labeller = labeller(ExperienceLevel = c("1" = "Beginner", "2" = "Intermediate", "3" = "Advanced"))) +
scale_color_gradient(low = color_low, high = color_high, name = "Calories\nBurned") +
labs(title = paste(gender, "Gym Members"),
x = "Body Mass Index (BMI)",
y = "Fat Percentage") +
theme_minimal(base_size = 12) +
theme(legend.position = "right",
plot.title = element_text(hjust = 0.5, face = "bold")) +
geom_smooth(method = "lm", se = FALSE, linetype = "dashed", alpha = 0.5, color = "black") +
annotate("rect", xmin = 18.5, xmax = 24.9, ymin = -Inf, ymax = Inf,
fill = "green", alpha = 0.1) +
annotate("text", x = 21.7, y = min(data$FatPercentage),
label = "Healthy BMI Range", fontface = "bold", vjust = 0, size = 3) +
coord_cartesian(clip = "off")
}
# Create plots for men and women
men_plot <- create_gender_plot(subset(gym_members_data, Gender == "Male"), "Male", "lightblue", "darkblue")
women_plot <- create_gender_plot(subset(gym_members_data, Gender == "Female"), "Female", "pink", "deeppink")
# Combine plots
combined_plot <- men_plot + women_plot +
plot_layout(ncol = 2) +
plot_annotation(
title = "Relationship between BMI, Fat Percentage, and Calories Burned",
subtitle = "Grouped by Gender and Experience Level",
theme = theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 16),
plot.subtitle = element_text(hjust = 0.5, size = 14))
)
# Save the combined plot
ggsave("gym_fitness_analysis_by_gender.png", combined_plot, width = 16, height = 8, dpi = 300)
